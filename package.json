{
  "name": "workbuff-root",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix ems\" \"npm run start --prefix server\"",
    "build": "npm run build --prefix ems && rm -rf dist && mv ems/dist dist",
    "start": "npm run start --prefix server",
    "postinstall": "npm install --prefix server && npm install --prefix ems"
  },
  "dependencies": {
    "@clerk/backend": "^3.0.1",
    "@clerk/express": "^2.0.1",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.13.3",
    "multer": "^1.4.5-lts.2",
    "nodemon": "^3.1.10",
    "path": "^0.12.7",
    "concurrently": "^8.2.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "vite": "^8.0.16"
  }
}
